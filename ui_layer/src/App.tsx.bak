      setSystemState(await api.systemState());
    } catch {
      // 忽略
    }
  }, []);

  const loadAiStatus = useCallback(async () => {
    try {
      setAiStatus(await api.aiStatus());
    } catch {
      // 忽略
    }
  }, []);

  const openAiDialog = useCallback((cfg?: AiConfig) => {
    if (cfg) {
      setAiEditingId(cfg.id);
      setAiForm({
