    pc_tier1_close_pct: "50",
    pc_tier2_profit: "1000",
    pc_tier2_close_pct: "30",
    pc_breakeven_buffer: "0.5",
  });
  const [matcherForm, setMatcherForm] = useState({
    symbol,
