# 应用
DEBUG=1
HOST=127.0.0.1
PORT=8000

# 数据库：默认 SQLite；生产可切换 PostgreSQL / TimescaleDB
DATABASE_URL=sqlite:///./data/factor_store.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/forex_ai

# Redis（信号与特征缓存，可选）
REDIS_URL=

# AI 大模型：simulated / openai / anthropic / auto
LLM_PROVIDER=simulated
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 告警（Telegram，可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 企业微信机器人 Webhook（可选）
WECHAT_WEBHOOK=
# 钉钉机器人 Webhook（可选）
DINGTALK_WEBHOOK=
# 飞书机器人 Webhook（可选）
FEISHU_WEBHOOK=
# 邮件告警（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# 经纪商：mt5 = MetaTrader 5 实盘网关与数据源，paper = 仅测试用模拟执行
BROKER=paper
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=D:\MT4BC\terminal64.exe
MT5_MAGIC=202608

# 欧易 OKX 网关（加密交易所，与 MT5 并存）
# 总开关：0=不启用，1=启用
OKX_ENABLE=0
# 密钥：在 OKX「模拟盘(沙盒)」环境创建，只勾选 只读+交易，绝不勾提币
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 环境：1=模拟盘(沙盒)，0=实盘
OKX_FLAG=1
# 保证金模式：cross 全仓 / isolated 逐仓 / cash 现货
OKX_TD_MODE=cross
# 持仓模式：both 双向(可同时持多空) / net 单向净持仓
OKX_POS_SIDE_MODE=both
# 代理：留空=自动探测系统代理；direct=强制直连；或 http://127.0.0.1:端口
OKX_PROXY_URL=
# 允许交易的合约类型
OKX_INST_TYPES=SWAP,SPOT,FUTURES
# 场所路由：route=按 symbol 自动路由；mt5 或 okx=全局强制切换
VENUE_MODE=route

# AI 自动执行（板块四 -> 板块八闭环）
AUTO_TRADE_ENABLED=1
AUTO_TRADE_MIN_CONFIDENCE=0.55
AUTO_TRADE_MAX_POSITIONS=5
AUTO_TRADE_RISK_PERCENT=1.0
AUTO_TRADE_SYMBOL=EURUSD
AUTO_TRADE_TIMEFRAME=M15

# 异常点差告警（板块三）
SPREAD_ALERT_THRESHOLD=50
SPREAD_ALERT_COOLDOWN_SECONDS=300
MAX_DRAWDOWN_PCT=20
PATTERN_MIN_SIMILARITY=0.85
PATTERN_MIN_SAMPLES=3
PATTERN_TIME_DECAY_DAYS=365

# 账户与风控默认值
ACCOUNT_EQUITY=10000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_POSITIONS=5
LEVERAGE=30
CONTRACT_SIZE=100000

# 系统后台循环间隔（毫秒）
MARKET_TICK_MS=3000
BACKTEST_ENGINE=custom
